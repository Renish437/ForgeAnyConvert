# The backend needs LibreOffice, Pandoc, Calibre, Ghostscript, qpdf, and
# ffmpeg installed at the OS level (see backend/Dockerfile) — that isn't
# something Vercel's serverless functions support, so it isn't part of this
# deployment at all. Host it separately (Docker on Render/Railway/Fly.io/a
# VPS) and point the frontend at it via the VITE_API_BASE_URL env var below.
backend

# Reinstalled fresh by installCommand in vercel.json — no need to upload it.
frontend/node_modules

# Build output is regenerated on every deploy.
frontend/dist
